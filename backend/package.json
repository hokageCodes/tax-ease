{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "db:migrate": "knex --knexfile src/db/knexfile.ts migrate:latest",
    "db:rollback": "knex --knexfile src/db/knexfile.ts migrate:rollback",
    "db:seed": "knex --knexfile src/db/knexfile.ts seed:run",
    "setup": "npm install && npm run db:migrate && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "knex": "^3.2.10",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0"
  }
}
